# Postgres — matches the service in compose.yaml
DATABASE_USER=birbguessr
DATABASE_PASSWORD=change-me
DATABASE_HOST=localhost
DATABASE_PORT=5433
DATABASE_NAME=birbguessr_development

# Blazer reads its data source from here (see config/blazer.yml)
BLAZER_DATABASE_URL=postgres://birbguessr:change-me@localhost:5433/birbguessr_development

# SOLID_QUEUE_IN_PUMA is deliberately NOT set. It makes Puma boot Solid Queue's
# supervisor, which forks -- and forked children segfault in PG.connect on this
# Ruby/pg/macOS combination, taking Puma down with them. Development uses the :async
# queue adapter instead (see config/environments/development.rb).

# Amazon SES (SMTP endpoint). Leave SMTP_USERNAME unset in development and mail
# is written to tmp/mails instead of being sent. SES SMTP credentials are
# generated in the SES console -- they are NOT an IAM access key pair.
SES_REGION=us-east-1
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=birbguessr <login@yourdomain.com>

# While SES is in the sandbox, set this to route every outgoing message to one
# verified inbox so no real address is ever emailed by accident.
# MAIL_INTERCEPT_TO=you@brown.edu
