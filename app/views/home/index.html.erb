<div>
  <h1>birbguessr</h1>
  <p>The app is up and connected to the database.</p>

  <ul>
    <li><%= link_to "Birbs", birbs_path %></li>
    <% if authenticated? %>
      <li>Signed in as <span><%= Current.user.email_address %></span></li>
      <% if Current.user.admin? %>
        <li><%= link_to "Admin", admin_path %></li>
      <% end %>
      <li><%= button_to "Sign out", logout_path, method: :delete %></li>
    <% else %>
      <li><%= link_to "Sign in", new_login_path %></li>
    <% end %>
  </ul>
</div>
