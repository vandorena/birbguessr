<div>
  <h1>Check your email</h1>
  <p>
    We sent you a sign-in link and a six-digit code. Click the link, or type the code
    here. Both expire in <%= LoginCode::EXPIRATION.inspect %>.
  </p>

  <%= render "shared/flash" %>

  <%= form_with url: complete_login_path do |form| %>
    <div>
      <%= form.label :code, "Sign-in code" %>
      <%= form.text_field :code, required: true, autofocus: true,
            autocomplete: "one-time-code", inputmode: "numeric", placeholder: "123-456" %>
    </div>

    <%= form.submit "Sign in" %>
  <% end %>

  <p>
    <%= link_to "Use a different email address", new_login_path %>
  </p>
</div>
